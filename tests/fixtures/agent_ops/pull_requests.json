    {
      "name": "low risk green pr can merge when policy allows it",
      "policy": {
        "auto_merge_green_prs": true
      },
      "high_risk_patterns": ["auth", "secret", "sync", "schema", "launchd", "background"],
      "pr": {
        "repo": "owner/repo",
        "number": 10,
        "title": "Fix README wording",
        "url": "https://github.com/owner/repo/pull/10",
        "head_ref": "docs-readme",
        "base_ref": "main",
        "is_draft": false,
        "merge_state": "CLEAN",
        "review_decision": null,
        "check_status": "success",
        "changed_files": ["README.md"]
      },
      "expected": {
        "disposition": "auto-act",
        "category": "merge-green-pr"
      }
    },
